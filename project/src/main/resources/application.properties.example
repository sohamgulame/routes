# ====================================================================
# AURA-NER Spring Boot Configuration Example Template
# Rename this file to application.properties for local execution
# ====================================================================

# Server Configuration
server.port=${SERVER_PORT:8080}

# Application Name
spring.application.name=auraner-backend

# PostgreSQL + PostGIS Datasource
spring.datasource.url=jdbc:postgresql://${AURANER_DB_HOST:localhost}:${AURANER_DB_PORT:5433}/${AURANER_DB_NAME:auraner_db}
spring.datasource.username=${AURANER_DB_USER:postgres}
spring.datasource.password=${AURANER_DB_PASSWORD:your_password_here}
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA & Hibernate Spatial Configuration
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=${HIBERNATE_DDL_AUTO:update}
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.jdbc.batch_size=50

# Flyway Database Migrations
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.validate-on-migrate=false
spring.flyway.repair-on-migrate=true
spring.flyway.locations=classpath:db/migration

# Redis Cache
spring.data.redis.host=${REDIS_HOST:localhost}
spring.data.redis.port=${REDIS_PORT:6379}

# File Upload Limits
spring.servlet.multipart.max-file-size=20MB
spring.servlet.multipart.max-request-size=25MB

# JWT Security
app.jwt.secret=${JWT_SECRET:your_jwt_secret_key_here}
app.jwt.expiration-ms=86400000

# Python FastAPI AI Service Integration URL
ai.service.url=${AI_SERVICE_URL:http://localhost:8000}

# Open-Meteo Weather API Integration
weather.api.url=https://api.open-meteo.com/v1/forecast

# Actuator Endpoints
management.endpoints.web.exposure.include=health,info,metrics
management.endpoint.health.show-details=always

# Emergency SMS & WhatsApp Gateway Configuration
app.sms.gateway.provider=${SMS_GATEWAY_PROVIDER:FAST2SMS}
app.sms.gateway.api-key=${SMS_GATEWAY_API_KEY:}
app.sms.twilio.account-sid=${TWILIO_ACCOUNT_SID:}
app.sms.twilio.auth-token=${TWILIO_AUTH_TOKEN:}
app.sms.twilio.from-number=${TWILIO_FROM_NUMBER:+15005550006}
